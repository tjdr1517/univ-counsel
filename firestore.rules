rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isTeacher() { return signedIn() && myProfile().data.role == 'teacher'; }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'student';
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'teacherId'])) ||
        (isTeacher()
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.role == 'student')
      );
      allow delete: if false;
    }

    match /consultations/{recordId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.studentId == resource.data.studentId;
    }

    match /announcements/{postId} {
      allow read: if signedIn();
      allow create: if isTeacher()
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isTeacher()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
    }
  }
}
