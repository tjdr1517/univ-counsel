rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isTeacher() { return signedIn() && myProfile().data.role == 'teacher'; }
    function isAllowlistedTeacher() {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/teacherAllowlist/$(request.auth.token.email));
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.role == 'student' ||
          (request.resource.data.role == 'teacher' && isAllowlistedTeacher())
        );
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (isTeacher() && resource.data.teacherId == request.auth.uid)
      );
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'grade', 'classNumber', 'connectionCode']) ||
            (resource.data.role == 'student'
              && request.resource.data.role == 'teacher'
              && isAllowlistedTeacher()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])) ||
            (resource.data.role == 'student'
              && request.resource.data.role == 'student'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherId', 'teacherName', 'teacherCode'])
              && exists(/databases/$(database)/documents/teacherCodes/$(request.resource.data.teacherCode))
              && request.resource.data.teacherId == get(/databases/$(database)/documents/teacherCodes/$(request.resource.data.teacherCode)).data.teacherId
              && request.resource.data.teacherName == get(/databases/$(database)/documents/teacherCodes/$(request.resource.data.teacherCode)).data.teacherName)
          )) ||
        (isTeacher()
          && resource.data.teacherId == request.auth.uid
          && request.resource.data.role == 'student'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'grade', 'classNumber']))
      );
      allow delete: if false;
    }

    match /teacherAllowlist/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }

    match /teacherCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isTeacher()
        && code.size() == 6
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId;
    }

    match /consultations/{recordId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.resource.data.studentId)).data.role == 'student'
        && get(/databases/$(database)/documents/users/$(request.resource.data.studentId)).data.teacherId == request.auth.uid;
      allow update, delete: if isTeacher()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.studentId == resource.data.studentId;
    }

    match /announcements/{postId} {
      allow read: if signedIn();
      allow create: if isTeacher()
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isTeacher()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
    }
  }
}
